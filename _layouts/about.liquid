---
layout: default
---
<div class="post">
  <header class="post-header">
    {% if page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article>
    <div class="about-layout">
      {% if page.profile %}
        <aside class="about-sidebar">
          <div class="sidebar-sticky">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: 768px) 240px, 60vw{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          <div class="sidebar-identity">
            <p class="sidebar-name">
              {%- if site.first_name %}{{ site.first_name }}{% endif -%}
              {%- if site.last_name %} {{ site.last_name }}{% endif -%}
            </p>
            {% if page.profile.title %}
              <p class="profile-title">{{ page.profile.title }}</p>
            {% endif %}
            {% if page.profile.subtitle %}
              <p class="profile-subtitle">{{ page.profile.subtitle }}</p>
            {% endif %}
            {% if page.profile.more_info %}
              <div class="more-info">{{ page.profile.more_info }}</div>
            {% endif %}
          </div>
          {% if page.social %}
            <div class="sidebar-social">{% include social.liquid %}</div>
          {% endif %}
          <nav class="sidebar-secnav" aria-label="Section navigation">
            <a href="#about" class="secnav-link active" data-section="about">About</a>
            {% comment %} links to the page's collapsible sections are filled in by the script below {% endcomment %}
            <a href="{{ '/cv/' | relative_url }}" class="secnav-link secnav-cv">CV</a>
          </nav>
          </div>
        </aside>
      {% endif %}

      <div class="about-main">
        <div class="about-intro-text" id="about">
          {{ content | split: '<hr />' | first }}
        </div>

        <div class="about-rest">{{ content | split: '<hr />' | slice: 1, 100 | join: '<hr />' }}</div>

        <!-- Updates -->
        {% if page.announcements and page.announcements.enabled %}
          <h2 class="about-section-title" id="news">
            <a href="{{ '/news/' | relative_url }}" style="color: inherit">Updates</a>
          </h2>
          {% include news.liquid limit=true %}
        {% endif %}

        <!-- Latest posts -->
        {% if page.latest_posts and page.latest_posts.enabled %}
          <h2>
            <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
          </h2>
          {% include latest_posts.liquid %}
        {% endif %}

        <!-- Selected papers -->
        {% if page.selected_papers %}
          <h2>
            <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
          </h2>
          {% include selected_papers.liquid %}
        {% endif %}

        {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
          {% include newsletter.liquid center=true %}
        {% endif %}
      </div>
    </div>

    {% include view_counter.liquid %}
  </article>
</div>

<script>
  (function () {
    function openTargetSection() {
      var id = location.hash.slice(1);
      if (!id) return;
      var el = document.getElementById(id);
      if (el && el.tagName === 'DETAILS') el.open = true;
    }
    window.addEventListener('hashchange', openTargetSection);
    openTargetSection();
  })();

  (function () {
    var nav = document.querySelector('.sidebar-secnav');
    if (!nav) return;
    var cvLink = nav.querySelector('.secnav-cv');

    // one nav link per collapsible section, inserted in page order before the CV link
    var sections = document.querySelectorAll('.about-main details.about-collapsible[id]');
    sections.forEach(function (sec) {
      var title = sec.querySelector('summary .about-section-title');
      if (!title) return;
      var a = document.createElement('a');
      a.className = 'secnav-link';
      a.href = '#' + sec.id;
      a.dataset.section = sec.id;
      a.textContent = title.textContent.trim();
      nav.insertBefore(a, cvLink);
    });

    var newsHeading = document.getElementById('news');
    if (newsHeading) {
      var a = document.createElement('a');
      a.className = 'secnav-link';
      a.href = '#news';
      a.dataset.section = 'news';
      a.textContent = 'Updates';
      nav.insertBefore(a, cvLink);
    }

    // highlight the section currently in view
    var targets = [document.getElementById('about')].concat(Array.prototype.slice.call(sections));
    if (newsHeading) targets.push(newsHeading);
    targets = targets.filter(Boolean);

    function setActive(id) {
      nav.querySelectorAll('.secnav-link').forEach(function (l) {
        l.classList.toggle('active', l.dataset.section === id);
      });
    }

    if ('IntersectionObserver' in window) {
      var current = 'about';
      var visible = new Map();
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            visible.set(e.target.id, e.isIntersecting);
          });
          for (var i = 0; i < targets.length; i++) {
            if (visible.get(targets[i].id)) {
              current = targets[i].id;
              break;
            }
          }
          setActive(current);
        },
        { rootMargin: '-15% 0px -60% 0px' }
      );
      targets.forEach(function (t) {
        observer.observe(t);
      });
    }
  })();
</script>
